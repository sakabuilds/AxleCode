# Axle cloud worker configuration. Copy into the worker host environment.
# The control plane worker entry (AXLE_CLOUD_CONFIG in the account API) must
# list the same workerId, token, and environment ids that appear here.

AXLE_CLOUD_WORKER_CONFIG={"controlPlaneUrl":"https://accounts.example.com","workerId":"worker-1","workerToken":"replace-with-the-control-plane-worker-token","environmentIds":["linux-standard"],"workspaceRoot":"/var/lib/axle-cloud/work","artifactRoot":"/var/lib/axle-cloud/artifacts","providers":[{"providerInstanceId":"anthropic-default","provider":"anthropic","apiKeyEnv":"ANTHROPIC_API_KEY"}]}

# Provider credentials live only in the worker host environment and are passed
# to the agent process for the provider selected by the claimed job.
ANTHROPIC_API_KEY=replace-with-the-provider-key
