# Server-only account API configuration. Never expose this file to browser builds.
# MongoDB connection string (MongoDB Atlas in production). A replica set is
# required for the transactional cloud-job ledger.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?authSource=admin&replicaSet=atlas-xxxxxx-shard-0

# Identity provider whose access tokens this API verifies. The CLERK_* names
# are provider-agnostic: point them at any OIDC issuer. The Axle auth worker
# serves its JWKS under <CLERK_ISSUER>/.well-known/jwks.json.
# Point CLERK_AUDIENCE at the audience the desktop requests (axle-desktop).
CLERK_ISSUER=https://axle-auth.example.workers.dev
# CLERK_JWKS_URL defaults to <CLERK_ISSUER>/.well-known/jwks.json
CLERK_AUDIENCE=axle-desktop
# Legacy NEON_AUTH_* names remain supported during migration.
# NEON_AUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# NEON_AUTH_ISSUER=https://auth.example.com
# NEON_AUTH_AUDIENCE=axle-account-api

HOST=127.0.0.1
PORT=8788
AXLE_ACCOUNT_CORS_ORIGIN=http://127.0.0.1:5735

# Plan catalog for cloud jobs and billing, inline JSON. `gatewayCredits` is the
# monthly hosted-provider allowance granted when the subscription webhook
# confirms payment (Free keeps the 100/day gateway grant instead). See
# docs/cloud-execution.md for the full schema.
# AXLE_BILLING_CONFIG={"plans":[{"planId":"free","cloudJobsEnabled":false,"monthlyCredits":0,"maxConcurrentJobs":1,"gatewayCredits":0},{"planId":"pro","cloudJobsEnabled":true,"monthlyCredits":120,"maxConcurrentJobs":4,"gatewayCredits":2000},{"planId":"pro-plus","cloudJobsEnabled":true,"monthlyCredits":300,"maxConcurrentJobs":6,"gatewayCredits":4000},{"planId":"ultra","cloudJobsEnabled":true,"monthlyCredits":1000,"maxConcurrentJobs":8,"gatewayCredits":10000}],"defaultPlanId":"free","creditsPerMinute":3}
# Cloud-job runner configuration, inline JSON. Required to enable cloud
# execution; see docs/cloud-execution.md for the full schema.
# AXLE_CLOUD_CONFIG={"environments":[],"workers":[],"allowedUserIds":[],"maxActiveJobsPerUser":2,"leaseSeconds":60}

# Bachs payments (sandbox keys start with sk_sandbox_, live keys with sk_live_;
# the API base URL is derived from the key prefix). Checkout is disabled until
# the key and the required product ids are set.
AXLE_BACHS_API_KEY=sk_sandbox_replace_me
AXLE_PRO_BACHS_PRODUCT_ID=prod_replace_me
AXLE_PRO_PLUS_BACHS_PRODUCT_ID=prod_replace_me
AXLE_ULTRA_BACHS_PRODUCT_ID=prod_replace_me
AXLE_CREDITS_BACHS_PRODUCT_ID=prod_replace_me
# Legacy name for the Pro+ subscription product; used when
# AXLE_PRO_PLUS_BACHS_PRODUCT_ID is unset.
# AXLE_TEAM_BACHS_PRODUCT_ID=prod_replace_me
# Signing secret of the webhook endpoint registered for /v1/billing/webhook.
AXLE_BACHS_WEBHOOK_SECRET=whsec_replace_me
# Optional: override the derived API base URL, restrict payment corridors, or
# set the post-checkout redirect targets (https URLs).
# AXLE_BACHS_API_URL=https://sandbox-api.bachs.io
# AXLE_BACHS_PAYMENT_METHOD_TYPES=USD_CARD,NGN_BANK_TRANSFER
# AXLE_BACHS_SUCCESS_URL=https://axle.example.com/payment/success
# AXLE_BACHS_CANCEL_URL=https://axle.example.com/payment/cancelled

# Hosted-provider gateway: origin of the gateway (no /v1 suffix — the client
# appends /v1/internal/credits) and the shared bearer token it expects on that
# internal route. The same token is set as INTERNAL_API_TOKEN on the gateway.
AXLE_GATEWAY_INTERNAL_URL=https://axle-gateway.example.workers.dev
AXLE_INTERNAL_TOKEN=axlint_replace_me
